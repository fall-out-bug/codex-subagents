{
  "name": "codex-subagents",
  "version": "0.3.0",
  "description": "Launch pi, OpenCode, and GSD2 agents as external subagents from Codex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fall-out-bug/codex-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/fall-out-bug/codex-subagents/issues"
  },
  "homepage": "https://github.com/fall-out-bug/codex-subagents#readme",
  "type": "module",
  "bin": {
    "codex-subagent": "./dist/cli.js",
    "codex-subagents": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "codex",
    "subagents",
    "opencode",
    "pi",
    "gsd2",
    "cli",
    "agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "nanoid": "^5.1.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.15"
  }
}
